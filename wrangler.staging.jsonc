{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bullenciaga-staging",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "src/website.mjs"
}
