{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bullenciaga-staging",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "src/website.mjs",
  "d1_databases": [
    {
      "binding": "PLATFORM_SIGNUPS",
      "database_name": "bullen-platform-preview-staging",
      "database_id": "091e99bf-0819-48c3-b810-ed6a2f3e9f66",
      "migrations_dir": "migrations/platform"
    },
    {
      "binding": "GOODS_DB",
      "database_name": "bullenciaga-goods-staging",
      "database_id": "d06f2a63-df91-4d38-aaa2-6ca86e41b0bf",
      "migrations_dir": "migrations/goods"
    }
  ],
  "ratelimits": [
    {
      "name": "PLATFORM_LIMIT",
      "namespace_id": "9262602",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "MERCH_PREVIEW_LIMIT",
      "namespace_id": "9262604",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "services": [
    {
      "binding": "CONTROL_AUTH",
      "service": "rpc-proxy-staging"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MERCH_PREVIEW_ASSETS",
      "bucket_name": "bullenciaga-merch-preview-staging"
    }
  ],
  "vars": {
    "MERCH_PREVIEW_PREFIX": "collection01-v2-20261005",
    "GOODS_BENEFITS_ENABLED": "0",
    "GOODS_SHOP_ID": "sh_519b5285-451f-42f7-ba14-f2926fd1a7df"
  },
  "queues": {
    "producers": [
      {
        "binding": "GOODS_CUSTOM_QUEUE",
        "queue": "bullenciaga-goods-custom-staging"
      }
    ],
    "consumers": [
      {
        "queue": "bullenciaga-goods-custom-staging",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1,
        "retry_delay": 60,
        "dead_letter_queue": "bullenciaga-goods-custom-dlq-staging"
      }
    ]
  }
}
