{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bullenciaga",
  "compatibility_date": "2026-08-23",
  "routes": [
    {
      "pattern": "bullenciaga.com",
      "custom_domain": true
    },
    {
      "pattern": "www.bullenciaga.com",
      "custom_domain": true
    },
    {
      "pattern": "*.bullenciaga.com/*",
      "zone_name": "bullenciaga.com"
    },
    {
      "pattern": "bullen.app/*",
      "zone_name": "bullen.app"
    },
    {
      "pattern": "www.bullen.app/*",
      "zone_name": "bullen.app"
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "src/website.mjs",
  "d1_databases": [
    {
      "binding": "PLATFORM_SIGNUPS",
      "database_name": "bullen-platform-preview",
      "database_id": "3ca8afd0-91dc-4f2e-80ac-a28c2cf71a11",
      "migrations_dir": "migrations/platform"
    },
    {
      "binding": "GOODS_DB",
      "database_name": "bullenciaga-goods",
      "database_id": "6b0d33f6-9281-4416-b323-028f342161ca",
      "migrations_dir": "migrations/goods"
    }
  ],
  "ratelimits": [
    {
      "name": "PLATFORM_LIMIT",
      "namespace_id": "9262601",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "MERCH_PREVIEW_LIMIT",
      "namespace_id": "9262603",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "services": [
    {
      "binding": "CONTROL_AUTH",
      "service": "rpc-proxy"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MERCH_PREVIEW_ASSETS",
      "bucket_name": "bullenciaga-merch-preview"
    }
  ],
  "vars": {
    "MERCH_PREVIEW_PREFIX": "collection01-v2-20261005",
    "GOODS_BENEFITS_ENABLED": "1",
    "GOODS_SHOP_ID": "sh_519b5285-451f-42f7-ba14-f2926fd1a7df",
    "MERCH_PREVIEW_PROTECTED": "1"
  },
  "queues": {
    "producers": [
      {
        "binding": "GOODS_CUSTOM_QUEUE",
        "queue": "bullenciaga-goods-custom"
      }
    ],
    "consumers": [
      {
        "queue": "bullenciaga-goods-custom",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1,
        "retry_delay": 60,
        "dead_letter_queue": "bullenciaga-goods-custom-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
