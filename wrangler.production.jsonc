{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bullenciaga",
  "compatibility_date": "2026-08-23",
  "routes": [
    {
      "pattern": "bullenciaga.com",
      "custom_domain": true
    },
    {
      "pattern": "www.bullenciaga.com",
      "custom_domain": true
    },
    {
      "pattern": "*.bullenciaga.com/*",
      "zone_name": "bullenciaga.com"
    },
    {
      "pattern": "bullen.app/*",
      "zone_name": "bullen.app"
    },
    {
      "pattern": "www.bullen.app/*",
      "zone_name": "bullen.app"
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "src/website.mjs"
}
