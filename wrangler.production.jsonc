{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bullenciaga",
  "compatibility_date": "2026-08-23",
  "routes": [
    {
      "pattern": "bullenciaga.com",
      "custom_domain": true
    },
    {
      "pattern": "www.bullenciaga.com",
      "custom_domain": true
    },
    {
      "pattern": "*.bullenciaga.com/*",
      "zone_name": "bullenciaga.com"
    },
    {
      "pattern": "bullen.app/*",
      "zone_name": "bullen.app"
    },
    {
      "pattern": "www.bullen.app/*",
      "zone_name": "bullen.app"
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "src/website.mjs",
  "d1_databases": [
    {
      "binding": "PLATFORM_SIGNUPS",
      "database_name": "bullen-platform-preview",
      "database_id": "3ca8afd0-91dc-4f2e-80ac-a28c2cf71a11",
      "migrations_dir": "migrations/platform"
    }
  ],
  "ratelimits": [
    {
      "name": "PLATFORM_LIMIT",
      "namespace_id": "9262601",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
